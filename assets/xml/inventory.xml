<div id="inv" modal="true" layout="column" anchor="center"
     bg="#0008" padding="12" gap="8">
  <div layout="column" bg="#c6c6c6" border="3" border-color="#373737"
       padding="8" gap="8">
    <div layout="row" align="center" justify="between" width="100%">
      <label font-size="20" color="#404040">{{title}}</label>
      <button id="close" on-click="inventory:close" bg="#777777"
              hover-bg="#999999" pressed-bg="#555555" border="2"
              border-color="#303030" padding="2 8" radius="0">
        <label font-size="16" color="#ffffff">X</label>
      </button>
    </div>

    <div layout="grid" cols="9" gap="4" padding="6" bg="#8b8b8b"
         border="2" border-color="#373737">
      <div v-for="s in slots" id="slot_{{s.index}}"
           on-click="inventory:click" on-secondary-click="inventory:click"
           data="{{s.index}}"
           bg="#555555" border="2" border-color="#373737"
           width="40" height="40" align="center" justify="center">
        <div v-if="s.item" id="item_{{s.index}}"
             on-click="inventory:click" on-secondary-click="inventory:click"
             data="{{s.index}}" z_index="10"
             bg="{{s.item.color}}" border="2" border-color="#eeeeee"
             width="34" height="34" align="center" justify="center">
          <img v-if="s.item.img" src="{{s.item.img}}" alt="?" width="30" height="30"/>
          <label font-size="11" color="#ffffff">{{s.item.short}}</label>
          <label position="absolute" right="1" bottom="0" font-size="10" color="#ffffff">{{s.item.count}}</label>
        </div>
      </div>
    </div>

    <label font-size="14" color="#404040">Hotbar</label>
    <div layout="row" gap="4" padding="6" bg="#8b8b8b"
         border="2" border-color="#373737">
      <div v-for="s in slots2" id="slot_{{s.index}}"
           on-click="inventory:click" on-secondary-click="inventory:click"
           data="{{s.index}}"
           bg="{{s.selected_bg}}" border="2" border-color="#373737"
           width="40" height="40" align="center" justify="center">
        <div v-if="s.item" id="item_{{s.index}}"
             on-click="inventory:click" on-secondary-click="inventory:click"
             data="{{s.index}}"
             bg="{{s.item.color}}" border="2" border-color="#eeeeee"
             width="34" height="34" align="center" justify="center">
          <img v-if="s.item.img" src="{{s.item.img}}" alt="?" width="30" height="30"/>
          <label font-size="11" color="#ffffff">{{s.item.short}}</label>
          <label position="absolute" right="1" bottom="0" font-size="10" color="#ffffff">{{s.item.count}}</label>
        </div>
      </div>
    </div>

    <label font-size="14" color="#404040">Creative (scroll)</label>
    <div layout="grid" cols="9" gap="2" padding="4" bg="#8b8b8b"
         border="2" border-color="#373737" overflow="scroll" height="320">
      <div v-for="c in creative" on-click="inventory:creative"
           data="{{c.name}}" width="44" height="44">
        <img src="{{c.img}}" alt="?" width="40" height="40"/>
      </div>
    </div>
  </div>
  <cursor v-if="held_item" width="40" height="40" layout="column"
          bg="{{held_item.color}}" border="2" border-color="#ffffff"
          padding="2" align="center" justify="center">
    <label font-size="11" color="#ffffff">{{held_item.short}}</label>
    <label font-size="9" color="#ffffff">{{held_item.count}}</label>
  </cursor>
</div>
