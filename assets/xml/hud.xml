<div anchor="bottom" layout="column" align="center" gap="2" padding="0 0 8">
  <div layout="row" gap="4" padding="4" bg="#00000088" border="2" border-color="#333333">
    <div v-for="s in slots" bg="{{s.bg}}" border="2" border-color="{{s.border}}"
         width="44" height="44" align="center" justify="center">
      <img v-if="s.img" src="{{s.img}}" alt="?" width="36" height="36"/>
      <label v-if="s.img" position="absolute" right="2" bottom="0" font-size="11" color="#ffffff">{{s.count}}</label>
    </div>
  </div>
</div>
