<!--
  DEV-ONLY test screen for the SDUI pipeline (see client/src/ui/dev_reload.rs).
  Press F5 in-game to load/reload this. Not part of the real protocol —
  a real screen comes from the server as a `UiShow` packet's `xml` field.
-->
<div id="dev_panel" anchor="center" layout="column" gap="8" padding="16"
     bg="#222831ee" border="2" border-color="#ffffff55" radius="8" modal="true">

  <label font-size="22" color="#ffffff">SDUI dev panel</label>

  <div layout="row" gap="6">
    <button id="ping" on-click="dev:ping" bg="#3a6ea5" hover-bg="#4d84c2"
            pressed-bg="#2c527d" padding="6 12" radius="4">
      <label color="#ffffff">Ping</label>
    </button>
    <button id="close" on-click="client:close" bg="#a53a3a" hover-bg="#c24d4d"
            pressed-bg="#7d2c2c" padding="6 12" radius="4">
      <label color="#ffffff">Close</label>
    </button>
  </div>

  <label font-size="12" color="#ffffffaa">
    id/on-click/data round-trip via UiAction; Ping has none, Close uses the
    reserved client:close action (handled locally, nothing sent).
  </label>

</div>
